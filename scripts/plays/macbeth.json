{
  "play": "Macbeth",
  "soliloquies": [
    {
      "id": "raven-himself-hoarse",
      "title": "The raven himself is hoarse",
      "character": "Lady Macbeth",
      "act": "Act 1, Scene 5",
      "chunks": [
        { "front": "The raven himself", "back": "is hoarse" },
        { "front": "That croaks the fatal entrance", "back": "of Duncan" },
        { "front": "Under my battlements.", "back": "Come, you spirits" },
        { "front": "That tend on mortal thoughts,", "back": "unsex me here," },
        { "front": "And fill me from the crown", "back": "to the toe top-full" },
        { "front": "Of direst cruelty.", "back": "Make thick my blood." },
        { "front": "Stop up the access", "back": "and passage to remorse" },
        { "front": "That no compunctious visitings", "back": "of nature" },
        { "front": "Shake my fell purpose,", "back": "nor keep peace between" },
        { "front": "The effect and it.", "back": "Come to my woman's breasts," },
        { "front": "And take my milk for gall,", "back": "you murd'ring ministers," },
        { "front": "Wherever in your sightless substances", "back": "you wait on nature's mischief." },
        { "front": "Come, thick night,", "back": "and pall thee in the dunnest smoke of hell," },
        { "front": "That my keen knife", "back": "see not the wound it makes," },
        { "front": "Nor heaven peep", "back": "through the blanket of the dark" },
        { "front": "To cry", "back": "'Hold, hold!'" }
      ],
      "beats": [
        {
          "label": "Summon The Darkness",
          "intention": "To call the powers of darkness to attend her",
          "startChunk": 0,
          "endChunk": 2
        },
        {
          "label": "Demand Transformation",
          "intention": "To be unsexed and remade wholly with cruelty",
          "startChunk": 3,
          "endChunk": 5
        },
        {
          "label": "Seal Off Conscience",
          "intention": "To block pity, hesitation, and remorse from her purpose",
          "startChunk": 6,
          "endChunk": 8
        },
        {
          "label": "Weaponize The Feminine",
          "intention": "To offer her mother's milk to the murdering spirits",
          "startChunk": 9,
          "endChunk": 11
        },
        {
          "label": "Blindfold Heaven",
          "intention": "To pull night over the deed so no light can witness it",
          "startChunk": 12,
          "endChunk": 15
        }
      ]
    },
    {
      "id": "glamis-thou-art",
      "title": "Glamis thou art, and Cawdor",
      "character": "Lady Macbeth",
      "act": "Act 1, Scene 5",
      "chunks": [
        { "front": "Glamis thou art,", "back": "and Cawdor;" },
        { "front": "and shalt be what thou", "back": "art promised." },
        { "front": "Yet do I fear", "back": "thy nature;" },
        { "front": "it is too full o' the milk", "back": "of human kindness" },
        { "front": "to catch", "back": "the nearest way." },
        { "front": "Thou wouldst be great,", "back": "art not without ambition," },
        { "front": "but without the illness", "back": "should attend it." },
        { "front": "What thou wouldst highly,", "back": "that wouldst thou holily;" },
        { "front": "wouldst not play false,", "back": "and yet wouldst wrongly win." },
        { "front": "Thou'ldst have, great Glamis,", "back": "that which cries 'Thus thou must do,'" },
        { "front": "if thou have it;", "back": "and that which rather" },
        { "front": "thou dost fear to do,", "back": "than wishest should be undone." },
        { "front": "Hie thee hither,", "back": "that I may pour" },
        { "front": "my spirits", "back": "in thine ear," },
        { "front": "and chastise with the valor", "back": "of my tongue" },
        { "front": "all that impedes thee", "back": "from the golden round," },
        { "front": "which fate and metaphysical aid", "back": "doth seem" },
        { "front": "to have thee", "back": "crown'd withal." }
      ],
      "beats": [
        {
          "label": "Name The Obstacle",
          "intention": "To name what stands in her way — his tenderness",
          "startChunk": 0,
          "endChunk": 4
        },
        {
          "label": "Diagnose The Flaw",
          "intention": "To identify the exact defect — ambition without ruthlessness",
          "startChunk": 5,
          "endChunk": 6
        },
        {
          "label": "Catalogue The Contradictions",
          "intention": "To lay bare his moral confusion — he wants the crown but fears the deed",
          "startChunk": 7,
          "endChunk": 11
        },
        {
          "label": "Summon Him Home",
          "intention": "To call him back so she can drive out his conscience with her tongue",
          "startChunk": 12,
          "endChunk": 14
        },
        {
          "label": "Claim The Crown For Both",
          "intention": "To position herself as fate's instrument, removing what stalls the coronation",
          "startChunk": 15,
          "endChunk": 17
        }
      ]
    }
  ]
}
